# Copier ce fichier en .env puis adapter les valeurs.
DEBUG=True
SECRET_KEY=changez-moi
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://eventlead.ht

# SQLite par défaut. Production : PostgreSQL
# DATABASE_URL=postgres://eventlead:motdepasse@localhost:5432/eventlead

# Connexion Google (console.cloud.google.com > Identifiants > ID client OAuth)
# URI de redirection autorisée : http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paiements : en mode démo, aucune API n'est appelée.
PAYMENT_DEMO_MODE=True
VIP_ORGANIZER_PRICE_HTG=5000
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stockage des médias en production (ex : storages.backends.s3.S3Storage)
# DEFAULT_FILE_STORAGE_BACKEND=

# E-mails (relances des invités). Par défaut ils s'affichent dans le terminal du serveur au lieu de partir.
# Pour les envoyer vraiment, par exemple avec un compte SMTP :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemple.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=EventLead <no-reply@eventlead.ht>

CONTACT_EMAIL=contact@eventlead.ht
SITE_URL=http://localhost:8000
CONTACT_PHONE=+509 3700 0000
CONTACT_WHATSAPP=50937000000
CONTACT_ADDRESS=Pétion-Ville, Port-au-Prince, Haïti

# Solidité (docs/solidite.md)
# Adresses prévenues par e-mail à chaque erreur du serveur
# ADMINS=vous@exemple.com
# Limite de requêtes par visiteur et par minute (RATELIMIT_ENABLED=False pour la couper)
# RATELIMIT_PER_MINUTE=240
# RATELIMIT_POSTS_PER_MINUTE=40
# Hébergeur qui transmet l'adresse du visiteur (PythonAnywhere : HTTP_X_REAL_IP)
# REAL_IP_HEADER=
# Plafonds par jour : recherches d'adresse sur la carte, e-mails envoyés
# GEOCODER_DAILY_LIMIT=500
# EMAIL_DAILY_LIMIT=280
# Cache partagé en production (puis : python manage.py createcachetable)
# CACHE_URL=dbcache://eventlead_cache
